# ---- Server ----
PORT=3000
NODE_ENV=production
# Set to "1" (or a number/loopback list) when running behind a reverse proxy so
# rate limiting sees the real client IP. See https://expressjs.com/en/guide/behind-proxies.html
# (Defaults to 1 automatically on Vercel / AWS Lambda.)
TRUST_PROXY=0
# Public base URL of this deployment (used to build absolute og:image URLs on /share pages).
# Leave empty to derive it from each request (works on Vercel and behind proxies).
PUBLIC_BASE_URL=
# Comma separated list of origins allowed to call /api from other sites (empty = same-origin only)
CORS_ORIGIN=

# ---- Upstream lookup API ----
LOOKUP_API_URL=https://7u6959.af7u76.workers.dev/
LOOKUP_TIMEOUT_MS=10000
# Set to "true" to serve fixture data instead of calling the upstream API (handy for local dev / tests)
LOOKUP_MOCK=false

# ---- Caching ----
# Seconds a lookup result stays cached (default 7 days)
CACHE_TTL_SECONDS=604800
# Optional Redis connection string. Leave empty to use the in-memory cache.
REDIS_URL=
# REDIS_URL=redis://redis:6379
# Where generated social-card PNGs are written (on Vercel/Lambda this falls back to /tmp)
IMAGE_CACHE_DIR=./cache/images
# Seconds a generated image stays cached (default 7 days)
IMAGE_CACHE_TTL_SECONDS=604800

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
# Image rendering is expensive; it gets its own limit
IMAGE_RATE_LIMIT_MAX=20

# ---- Puppeteer ----
# Path to a Chrome/Chromium binary. Leave empty to auto-detect common locations.
PUPPETEER_EXECUTABLE_PATH=
# Max concurrent headless-browser renders
IMAGE_RENDER_CONCURRENCY=2
# Vercel / Lambda only: colour emoji font downloaded at cold start for the card renderer.
# Leave unset for the default Noto Color Emoji, or set to an empty value to disable.
# CARD_EMOJI_FONT_URL=

# ---- Logging ----
# Optional JSON-lines file for lookup analytics (number, timestamp, client IP)
LOG_FILE=
