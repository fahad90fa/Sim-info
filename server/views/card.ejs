<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: <%= width %>px; height: <%= height %>px; overflow: hidden; }
  body {
    font-family: "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Noto Color Emoji", "Apple Color Emoji", sans-serif;
    color: #f8fafc;
    background: #0f172a;
    background-image:
      radial-gradient(900px 500px at 85% -10%, rgba(56, 189, 248, 0.35), transparent 60%),
      radial-gradient(700px 500px at -10% 110%, rgba(129, 140, 248, 0.35), transparent 60%),
      linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    -webkit-font-smoothing: antialiased;
  }
  .card { position: relative; width: 100%; height: 100%; padding: 56px 64px; display: flex; flex-direction: column; }
  .brand { display: flex; align-items: center; gap: 14px; font-size: 22px; font-weight: 600; letter-spacing: 0.02em; color: #cbd5e1; }
  .brand .logo { width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, #38bdf8, #6366f1); display: grid; place-items: center; color: #fff; font-size: 22px; font-weight: 800; }
  .body { flex: 1; display: flex; gap: 48px; align-items: center; margin-top: 24px; }
  .info { flex: 1; min-width: 0; }
  .label { font-size: 20px; text-transform: uppercase; letter-spacing: 0.18em; color: #94a3b8; font-weight: 600; }
  .number { font-size: 76px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; margin: 8px 0 6px; font-variant-numeric: tabular-nums; }
  .country { font-size: 24px; color: #bae6fd; font-weight: 500; margin-bottom: 28px; }
  .names { display: flex; flex-wrap: wrap; gap: 12px; max-height: 190px; overflow: hidden; }
  .pill { font-size: 26px; font-weight: 600; padding: 10px 22px; border-radius: 999px; background: rgba(255, 255, 255, 0.10); border: 1.5px solid rgba(255, 255, 255, 0.18); white-space: nowrap; max-width: 520px; overflow: hidden; text-overflow: ellipsis; }
  .pill.more { background: transparent; color: #94a3b8; }
  .empty { font-size: 26px; color: #94a3b8; font-style: italic; }
  .avatar { width: 260px; height: 260px; border-radius: 48px; flex: none; overflow: hidden; background: linear-gradient(135deg, #38bdf8, #6366f1); display: grid; place-items: center; box-shadow: 0 30px 60px rgba(0,0,0,0.45), 0 0 0 6px rgba(255,255,255,0.08); }
  .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .avatar .initial { font-size: 132px; font-weight: 800; color: #fff; }
  .footer { display: flex; justify-content: space-between; align-items: center; font-size: 20px; color: #94a3b8; }
  .footer strong { color: #e2e8f0; font-weight: 600; }
</style>
</head>
<body>
  <div class="card">
    <div class="brand"><span class="logo">S</span> SIM Info · Phone Lookup</div>
    <div class="body">
      <div class="info">
        <div class="label">Phone number</div>
        <div class="number"><%= display %></div>
        <div class="country"><%= country || 'Lookup result' %></div>
        <% if (names.length) { %>
          <div class="names">
            <% names.forEach(function (name) { %><span class="pill"><%= name %></span><% }); %>
            <% if (extraNames > 0) { %><span class="pill more">+<%= extraNames %> more</span><% } %>
          </div>
        <% } else { %>
          <div class="empty">No names found for this number</div>
        <% } %>
      </div>
      <div class="avatar">
        <% if (thumbnail) { %>
          <img src="<%= thumbnail %>" alt="" onerror="this.parentNode.innerHTML='<span class=&quot;initial&quot;><%= initial %></span>'">
        <% } else { %>
          <span class="initial"><%= initial %></span>
        <% } %>
      </div>
    </div>
    <div class="footer">
      <span><strong><%= names.length + extraNames %></strong> name<%= (names.length + extraNames) === 1 ? '' : 's' %> found</span>
      <span>sim-info · Pakistan &amp; India</span>
    </div>
  </div>
</body>
</html>
